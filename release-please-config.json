{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    "packages/groundboard": {
      "release-type": "node",
      "package-name": "groundboard",
      "changelog-path": "CHANGELOG.md",
      "prerelease": true,
      "prerelease-type": "rc",
      "versioning": "prerelease",
      "component": "groundboard"
    },
    "packages/png": {
      "release-type": "node",
      "package-name": "@groundboard/png",
      "component": "png",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "prerelease": true,
      "prerelease-type": "rc",
      "versioning": "prerelease"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "groundboard",
      "components": ["groundboard", "png"]
    }
  ]
}
