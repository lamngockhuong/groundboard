      "sourceIds": ["s-reserve", "s-all-or-none"]
    },
    {
      "id": "n-capture",
      "kind": "step",
      "label": "Capture the payment",
      "groupId": "g-checkout",
      "sourceIds": ["s-capture"]
    },
    {
      "id": "n-void",
      "kind": "step",
      "label": "Void the authorization and decline: out of stock",
      "groupId": "g-checkout",
      "sourceIds": ["s-void"]
    },
    {
      "id": "n-cause",
      "kind": "cause",
      "label": "Stock is reserved only after the card is authorized",
