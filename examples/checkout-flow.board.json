      "sourceIds": ["s-open"]
    }
  ],
  "edges": [
    { "id": "e1", "from": "n-ready", "to": "n-authorize", "kind": "flow" },
    { "id": "e2", "from": "n-authorize", "to": "n-reserve", "kind": "flow" },
    { "id": "e3", "from": "n-reserve", "to": "n-capture", "kind": "flow", "label": "yes" },
    { "id": "e4", "from": "n-reserve", "to": "n-void", "kind": "flow", "label": "no" },
    { "id": "e5", "from": "n-cause", "to": "n-void", "kind": "causes" },
    { "id": "e6", "from": "n-rejected", "to": "n-cause", "kind": "relates" },
