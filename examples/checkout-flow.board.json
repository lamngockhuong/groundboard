  ],
  "nodes": [
    {
      "id": "n-ready",
      "kind": "step",
      "label": "Check the cart is ready",
      "detail": "Empty carts and guest carts are refused before any payment call.",
      "groupId": "g-checkout",
      "sourceIds": ["s-ready", "s-guest"]
    },
    {
      "id": "n-authorize",
      "kind": "step",
      "label": "Authorize the card for the cart total",
      "groupId": "g-checkout",
      "sourceIds": ["s-authorize"]
    },
    {
      "id": "n-reserve",
      "kind": "decision",
      "label": "Is every SKU in stock?",
