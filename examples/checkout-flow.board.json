    },
    {
      "id": "s-authorize",
      "path": "examples/fixtures/checkout/payment.ts",
      "line": 20,
      "quote": "await gateway.authorize(amount, cart.customerId as string)"
    },
    {
      "id": "s-reserve",
      "path": "examples/fixtures/checkout/payment.ts",
      "line": 21,
      "endLine": 22,
      "quote": "const reserved = await reserveStock(cart.lines); if (!reserved) {"
    },
    {
      "id": "s-all-or-none",
      "path": "examples/fixtures/checkout/inventory.ts",
      "line": 7,
