{
  "apis": {
    "api--orders": ["api:orders/get-id", "api:orders/post"],
    "api--cart": ["api:cart/post-lines"],
    "api--products": ["api:products/get"]
  },
  "calls": {
    "web--checkout": ["api:orders/post"],
    "web--products": ["api:cart/post-lines"],
    "mobile--order-detail": ["api:orders/get-id"]
  },
  "jobs": {
    "overview-batch": [
      "batch:close-stale-orders",
      "batch:prepare-shipment",
      "batch:send-receipt",
      "batch:sync-catalog"
    ]
  },
  "tables": {
    "overview-db": ["db:cart-lines", "db:order-items", "db:orders", "db:products"]
  },
  "screens": {
    "overview-web": ["web:account", "web:cart", "web:checkout", "web:home", "web:products"],
    "overview-mobile": ["mobile:cart", "mobile:catalog", "mobile:order-detail"]
  },
  "screenBoards": {
    "web--checkout": [
      { "role": "bar", "children": [{ "role": "icon" }, { "role": "text" }] },
      { "role": "text" },
      {
        "role": "container",
        "children": [
          {
            "role": "container",
            "children": [
              { "role": "input" },
              { "role": "input" },
              { "role": "input" },
              { "role": "checkbox" },
              { "role": "button" }
            ]
          },
          { "role": "container", "children": [{ "role": "text" }, { "role": "text" }] }
        ]
      },
      { "role": "link" }
    ],
    "mobile--cart": [
      { "role": "bar" },
      { "role": "text" },
      {
        "role": "container",
        "children": [
          {
            "role": "container",
            "children": [{ "role": "image" }, { "role": "text" }, { "role": "text" }]
          }
        ]
      },
      { "role": "text" },
      { "role": "button" },
      { "role": "link" },
      { "role": "bar", "children": [{ "role": "icon" }, { "role": "icon" }] }
    ],
    "web--products": [{ "role": "image" }, { "role": "text" }, { "role": "button" }],
    "web--account": [
      { "role": "text" },
      { "role": "text" },
      { "role": "container", "children": [{ "role": "button" }, { "role": "button" }] },
      { "role": "link" }
    ],
    "mobile--order-detail": [{ "role": "icon" }]
  }
}
